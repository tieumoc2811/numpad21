#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * 7 layer: 0 Numpad, 1 Media, 2 Nokia (nhap chu kieu Nokia cu: 1=1abc, 2=2def, 3=3ghi, 4=4jkl,
 *   5=5mno, 6=6pqr, 7=7stu, 8=8vwx, 9=9yz, 0=0+space, '.'=. , ? !; * = Shift, / = Caps Word,
 *   + = Backspace), 3-5 trong (gan bang ZMK Studio), 6 FN.
 * FN o tren cung (index 6) nen luon de len cac layer khac: giu FN thi cac phim FN luon hoat dong.
 *
 * Thu tu 21 phim trong moi layer (tren xuong, trai sang phai):
 *   ESC  TAB  BSPC FN
 *   NUM  /    *    -
 *   7    8    9
 *   4    5    6    +
 *   1    2    3    ENTER
 *   0    .
 *
 * FN layer (layer 6, giu phim FN):
 *   Hang tren : bootloader | chuyen layer (Numpad>Media>Nokia>L3>L4>L5) | doi USB/BLE | -
 *   Hang 2    : Studio unlock | BT0 | BT1 | BT2
 *   '.'       : chuyen che do LED ke tiep (1..9, vong lai)
 *   +  = BT3,  ENTER = BT4,  0 = ep dung USB,  1 = xoa ghep doi BT
 */

/ {
    /* Nhap chu kieu Nokia: bam lien tiep CUNG phim trong 0.6s de doi ky tu; ky tu hien ngay (gui Backspace + ky tu moi) */
    behaviors {
        td_1: td_1 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N1 A B C>;
        };
        td_2: td_2 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N2 D E F>;
        };
        td_3: td_3 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N3 G H I>;
        };
        td_4: td_4 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N4 J K L>;
        };
        td_5: td_5 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N5 M N O>;
        };
        td_6: td_6 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N6 P Q R>;
        };
        td_7: td_7 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N7 S T U>;
        };
        td_8: td_8 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N8 V W X>;
        };
        td_9: td_9 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N9 Y Z>;
        };
        td_0: td_0 {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <N0 SPACE>;
        };
        td_dot: td_dot {
            compatible = "zmk,behavior-multitap";
            #binding-cells = <0>;
            tapping-term-ms = <600>;
            keys = <DOT COMMA QMARK EXCL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";
            bindings = <
                &kp ESC    &kp TAB    &kp BSPC   &mo 6
                &kp KP_NUMLOCK &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS
                &kp KP_N7  &kp KP_N8  &kp KP_N9
                &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER
                &kp KP_N0  &kp KP_DOT &layer_cycle
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &kp C_PREV  &kp C_PP      &kp C_NEXT   &trans
                &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP &kp C_AL_CALC
                &kp HOME    &kp UP        &kp END
                &kp LEFT    &kp DOWN      &kp RIGHT    &kp PG_UP
                &kp INS     &kp DEL       &kp PG_DN    &kp RET
                &to 0       &trans &layer_cycle
            >;
        };

        nokia_layer {
            display-name = "Nokia";
            bindings = <
                &trans         &trans         &trans         &trans
                &none          &caps_word     &sk LSHFT      &kp MINUS
                &td_7          &td_8          &td_9
                &td_4          &td_5          &td_6          &kp BSPC
                &td_1          &td_2          &td_3          &kp RET
                &td_0          &td_dot        &layer_cycle
            >;
        };

        layer_3 {
            display-name = "Layer 3";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &to 0   &trans &layer_cycle
            >;
        };

        layer_4 {
            display-name = "Layer 4";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &to 0   &trans &layer_cycle
            >;
        };

        layer_5 {
            display-name = "Layer 5";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &to 0   &trans &layer_cycle
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
                &bootloader    &layer_cycle   &out OUT_TOG   &trans
                &studio_unlock &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2
                &none          &none          &none
                &none          &none          &none          &bt BT_SEL 3
                &bt BT_CLR     &none          &none          &bt BT_SEL 4
                &out OUT_USB   &led_mode 0 &trans
            >;
        };
    };
};
